{
  "name": "tailscale-exit-node-tui",
  "version": "0.1.0",
  "description": "A fast, single-screen terminal UI for choosing, switching and monitoring Tailscale exit nodes. Fully keyboard and mouse driven.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "tsexit": "./src/main.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "bun run src/main.ts",
    "demo": "bun run src/main.ts --demo",
    "dev": "bun --watch src/main.ts --demo",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "screenshot": "bun run scripts/screenshot.ts",
    "build": "bun build --compile --minify src/main.ts --outfile dist/tsexit"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "@opentui/core": "0.5.11"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.0"
  }
}
